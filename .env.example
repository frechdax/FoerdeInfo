# Official NAH.SH static GTFS (GovData: CC BY 4.0).
GTFS_STATIC_URL=https://www.connect-info.net/opendata/gtfs/nah.sh/rjqfrkqhgu
# Open-data fallback if the NAH.SH distribution endpoint is temporarily unavailable.
GTFS_STATIC_FALLBACK_URL=https://download.gtfs.de/germany/nv_free/latest.zip

# Public GTFS.de realtime feed. It is NOT mapped to NAH.SH trips by default,
# because the current trip IDs are incompatible.
GTFS_RT_URL=https://realtime.gtfs.de/realtime-free.pb
GTFS_RT_STATIC_URL=https://download.gtfs.de/germany/nv_free/latest.zip

# Optional DELFI/Mobilithek SIRI-ET feed.
# The Schleswig-Holstein offer is publicly catalogued, but the current package
# endpoint requires Authorization. Configure these only after lawful access is granted.
SIRI_ET_SH_URL=
SIRI_ET_SH_AUTHORIZATION=

# Optional explicitly permitted Aktiv Bus / Flensburg vehicle-position endpoint.
FLENSBURG_LIVE_API_URL=
FLENSBURG_LIVE_API_KEY=

NEXT_PUBLIC_MAP_STYLE_URL=https://tiles.openfreemap.org/styles/liberty
BUSKARTE_ALLOWED_ORIGIN=
BUSKARTE_ENABLE_SSE=false
