# Official NAH.SH static GTFS (GovData: CC BY 4.0). Current distribution endpoint used by the published dataset.
GTFS_STATIC_URL=https://www.connect-info.net/opendata/gtfs/nah.sh/rjqfrkqhgu
# Open-data fallback. Useful if the NAH.SH distribution endpoint is temporarily unavailable.
GTFS_STATIC_FALLBACK_URL=https://download.gtfs.de/germany/nv_free/latest.zip
GTFS_RT_URL=https://realtime.gtfs.de/realtime-free.pb

# Optional direct DELFI/SIRI-ET Schleswig-Holstein XML resource URL, only when explicitly published for reuse.
SIRI_ET_SH_URL=

# Optional: an explicitly permitted Aktiv Bus / Flensburg vehicle-position endpoint.
# Leave empty until you have a documented/publicly reusable endpoint or written permission.
FLENSBURG_LIVE_API_URL=
FLENSBURG_LIVE_API_KEY=

NEXT_PUBLIC_MAP_STYLE_URL=https://tiles.openfreemap.org/styles/liberty
BUSRADAR_ALLOWED_ORIGIN=
BUSRADAR_ENABLE_SSE=false
