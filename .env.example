# Open-data defaults. The free GTFS.de local-transit feed is published under a Creative Commons 4.0 license.
GTFS_STATIC_URL=https://download.gtfs.de/germany/nv_free/latest.zip
# Optional second lawful GTFS source. Leave empty unless its terms allow this use case.
GTFS_STATIC_FALLBACK_URL=
GTFS_RT_URL=https://realtime.gtfs.de/realtime-free.pb

# Optional direct DELFI/SIRI-ET Schleswig-Holstein XML resource URL, only when explicitly published for reuse.
SIRI_ET_SH_URL=

# Optional: an explicitly permitted Aktiv Bus / Flensburg vehicle-position endpoint.
# Leave empty until you have a documented/publicly reusable endpoint or written permission.
FLENSBURG_LIVE_API_URL=
FLENSBURG_LIVE_API_KEY=

# MapLibre style. OpenFreeMap can be replaced with your own tile provider.
NEXT_PUBLIC_MAP_STYLE_URL=https://tiles.openfreemap.org/styles/liberty

# Optional CORS origin for API consumers; web UI itself does not require this.
BUSRADAR_ALLOWED_ORIGIN=

# SSE holds one server connection per client. Enable after adding shared cache/Redis if desired.
BUSRADAR_ENABLE_SSE=false
